{
  "manifest_version": 3,
  "name": "MakerWorld → FlashForge AD5X",
  "version": "0.2.2",
  "description": "Adiciona 'Download for FlashForge AD5X' ao MakerWorld e converte projetos 3MF localmente.",
  "permissions": ["downloads", "offscreen", "storage"],
  "host_permissions": [
    "https://makerworld.com/*",
    "https://*.makerworld.com/*",
    "https://*.bambulab.com/*",
    "https://*.bambulab.cn/*",
    "https://*.bblmw.com/*",
    "https://*.bblmw.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://makerworld.com/*", "https://*.makerworld.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MakerWorld → FlashForge AD5X"
  }
}
